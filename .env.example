# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# --- External data / LLM APIs ---
NEWSAPI_KEY=your_newsapi_key_here
GROQ_API_KEY=your_groq_api_key_here
USER_EMAIL=you@example.com

# --- PostgreSQL (pgvector) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=financial_research
POSTGRES_HOST=localhost
# Host port published by docker-compose.yml (container still listens on 5432).
POSTGRES_PORT=5455

# --- Redis (Celery broker / cache) ---
REDIS_URL=redis://localhost:6379/0

# --- API ---
# Comma-separated allowed CORS origins (frontend URLs that may call the API).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
